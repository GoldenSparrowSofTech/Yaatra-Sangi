# Database Configuration
DATABASE_URL="file:./dev.db"

# Application Environment
NODE_ENV="development"
PORT=3001

# Authentication & Security
# Mandatory in production (min 32 characters). Application will fail to start in production if missing.
JWT_SECRET="your_secure_random_jwt_secret_min_32_chars"

# Allowed CORS Origins (comma-separated URLs)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Partner Subscription Billing (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Redis Cache / Session Store
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="your_secure_redis_password"
